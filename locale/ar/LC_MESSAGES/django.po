msgid "Les nouveaux mots de passe ne correspondent pas."
msgstr "كلمات المرور الجديدة غير متطابقة."

msgid "Identifiants invalides"
msgstr "بيانات الاعتماد غير صالحة"

msgid "Ancien mot de passe incorrect"
msgstr "كلمة المرور القديمة غير صحيحة"

msgid "Mot de passe changé avec succès"
msgstr "تم تغيير كلمة المرور بنجاح"

msgid "Vous ne pouvez pas vous ajouter vous-même."
msgstr "لا يمكنك إضافة نفسك."

msgid "Vous êtes déjà collaborateurs."
msgstr "أنتم بالفعل متعاونون."

msgid "Vous avez déjà envoyé une demande à cet utilisateur."
msgstr "لقد أرسلت بالفعل طلبًا إلى هذا المستخدم."

msgid "Demande envoyée à %(username)s."
msgstr "تم إرسال الطلب إلى %(username)s."